# Copy to .env and fill in; git ignores .env.

# Xcode → Settings → Accounts → your account → Team ID. Needed for an iPhone, not the simulator.
APPLE_TEAM_ID=

# Unique to you, such as com.yourname.sonifine. Keep it once installed: your sign-ins live under it.
BUNDLE_ID=

# Your app on developer.spotify.com (see the README).
SPOTIFY_CLIENT_ID=

# Your iPhone, from `xcrun devicectl list devices`.
IPHONE_UDID=
